# Assistant IA (compatible OpenAI). Sans clé, l'assistant affiche « pas encore configuré ».
# OpenRouter (par défaut) : clé gratuite sur https://openrouter.ai/keys, modèles gratuits terminés par « :free ».
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free
# Groq (plus rapide, niveau gratuit) :
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<un modèle listé dans votre console Groq>
