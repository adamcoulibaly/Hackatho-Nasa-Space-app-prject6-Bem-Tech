# Assistant IA (compatible OpenAI). Sans clé, l'assistant affiche « pas encore configuré ».
# OpenRouter (par défaut) : clé gratuite sur https://openrouter.ai/keys, modèles gratuits terminés par « :free ».
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3.5-super-vl:free
# Groq (plus rapide, niveau gratuit) :
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<un modèle listé dans votre console Groq>

# Modèle de vision pour la photo du champ (gratuit, OpenRouter)
LLM_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free

# Dictée (voix → texte) gratuite : Whisper sur Groq. Clé gratuite sur https://console.groq.com/keys
# Sans cette clé, la dictée utilise la reconnaissance vocale du téléphone (app) ou de Chrome.
STT_API_KEY=
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3-turbo
